<?xml version="1.0"?>
<!-- 差速轮 AGV：2 个连续驱动轮 + 2 个万向随动轮（固定关节） -->
<robot name="agv_diff_drive">
  <link name="base_footprint">
    <inertial><mass value="42.0"/>
      <inertia ixx="1.42" iyy="2.35" izz="2.35" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.85 0.62 0.28"/></geometry></visual>
  </link>
  <link name="wheel_left">
    <inertial><mass value="2.6"/>
      <inertia ixx="0.0072" iyy="0.0144" izz="0.0072" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.10" length="0.05"/></geometry></visual>
  </link>
  <link name="wheel_right">
    <inertial><mass value="2.6"/>
      <inertia ixx="0.0072" iyy="0.0144" izz="0.0072" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.10" length="0.05"/></geometry></visual>
  </link>
  <link name="caster_front">
    <inertial><mass value="0.4"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><sphere radius="0.035"/></geometry></visual>
  </link>
  <link name="caster_rear">
    <inertial><mass value="0.4"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><sphere radius="0.035"/></geometry></visual>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_footprint"/><child link="wheel_left"/>
    <origin xyz="0 0.31 -0.09" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="18" velocity="12.0"/>
  </joint>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_footprint"/><child link="wheel_right"/>
    <origin xyz="0 -0.31 -0.09" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="18" velocity="12.0"/>
  </joint>
  <joint name="caster_front_joint" type="fixed">
    <parent link="base_footprint"/><child link="caster_front"/>
    <origin xyz="0.28 0 -0.125" rpy="0 0 0"/>
  </joint>
  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_footprint"/><child link="caster_rear"/>
    <origin xyz="-0.28 0 -0.125" rpy="0 0 0"/>
  </joint>
</robot>
