<?xml version="1.0"?>
<!-- 体检用例：故意埋入 5 类常见错误，用来验证 A1~A8 规则能不能抓出来。
     ① A1 parent 指向不存在的连杆 ② A2 连续关节写了限位 ③ A4 连杆零质量
     ④ A6 轴向量未归一化 ⑤ A8 同一 child 被两个关节挂载 -->
<robot name="broken_case">
  <link name="base_link">
    <inertial><mass value="1.0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="link_a">
    <inertial><mass value="0.0"/>
      <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="link_b">
    <inertial><mass value="1.2"/>
      <inertia ixx="0.002" iyy="0.002" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="link_c">
    <inertial><mass value="0.8"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="j1" type="revolute">
    <parent link="base_link"/><child link="link_a"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.0" effort="10" velocity="2.0"/>
  </joint>
  <joint name="j2" type="continuous">
    <parent link="link_a"/><child link="link_b"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/><axis xyz="0 2 0"/>
    <limit lower="-1.0" upper="1.0" effort="10" velocity="2.0"/>
  </joint>
  <joint name="j3" type="revolute">
    <parent link="ghost_link"/><child link="link_c"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="j4" type="fixed">
    <parent link="base_link"/><child link="link_c"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
</robot>
