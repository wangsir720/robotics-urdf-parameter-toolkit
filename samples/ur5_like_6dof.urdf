<?xml version="1.0"?>
<!-- 6 轴串联工业臂（UR5 构型）。关节原点与质量取自厂商公开规格，非厂商原始文件，用于验证解析器。 -->
<robot name="ur5_like_6dof">
  <link name="base_link">
    <inertial><mass value="4.0"/>
      <inertia ixx="0.0044" iyy="0.0044" izz="0.0072" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.075" length="0.09"/></geometry></visual>
  </link>
  <link name="shoulder_link">
    <inertial><mass value="3.7"/>
      <inertia ixx="0.0102" iyy="0.0102" izz="0.0066" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.06" length="0.15"/></geometry></visual>
  </link>
  <link name="upper_arm_link">
    <inertial><mass value="8.393"/>
      <inertia ixx="0.1338" iyy="0.1338" izz="0.0151" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.05" length="0.425"/></geometry></visual>
  </link>
  <link name="forearm_link">
    <inertial><mass value="2.275"/>
      <inertia ixx="0.0312" iyy="0.0312" izz="0.0041" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.04" length="0.392"/></geometry></visual>
  </link>
  <link name="wrist_1_link">
    <inertial><mass value="1.219"/>
      <inertia ixx="0.0026" iyy="0.0026" izz="0.0022" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.03" length="0.09"/></geometry></visual>
  </link>
  <link name="wrist_2_link">
    <inertial><mass value="1.219"/>
      <inertia ixx="0.0026" iyy="0.0026" izz="0.0022" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.03" length="0.09"/></geometry></visual>
  </link>
  <link name="wrist_3_link">
    <inertial><mass value="0.1879"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.02" length="0.06"/></geometry></visual>
  </link>
  <link name="ee_link">
    <visual><geometry><box size="0.02 0.02 0.02"/></geometry></visual>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.089159" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.15"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0.13585 0" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.15"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0 -0.1197 0.425" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="150" velocity="3.15"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/><child link="wrist_1_link"/>
    <origin xyz="0 0 0.39225" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.2"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/><child link="wrist_2_link"/>
    <origin xyz="0 0.093 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.2"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/><child link="wrist_3_link"/>
    <origin xyz="0 0 0.09465" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.2"/>
  </joint>
  <joint name="ee_fixed_joint" type="fixed">
    <parent link="wrist_3_link"/><child link="ee_link"/>
    <origin xyz="0 0.0823 0" rpy="0 0 1.5708"/>
  </joint>
</robot>
